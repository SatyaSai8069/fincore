# ============================================================
# FINORA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and update values for your environment
# NEVER commit real secrets or production credentials to Git
# ============================================================

APP_NAME="FINORA Digital Banking Platform"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Settings
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security (Generate strong random keys for production)
SECRET_KEY="CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_HEX_STRING"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database — Primary PostgreSQL (Docker / Local)
DATABASE_URL="postgresql+asyncpg://finora_user:finora_dev_pass@localhost:5432/finora_db"

# Optional Lightweight Local SQLite Fallback (for running tests without Docker)
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./finora_dev.db"
USE_SQLITE_FALLBACK=false

# Redis (Caching, Rate Limiting & Idempotency)
REDIS_URL="redis://localhost:6379/0"